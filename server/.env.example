# پورت اجرای سرور (اغلب هاست‌ها خودشون این رو ست می‌کنن، نیازی به تغییر نیست)
PORT=5000

# آدرس اتصال به دیتابیس MongoDB
MONGO_URI=mongodb://localhost:27017/motor-oil-shop

# یک رشته‌ی رندوم و طولانی برای امضای JWT — هرگز مقدار توسعه رو تو پروداکشن استفاده نکن
# می‌تونی با این دستور یکی بسازی: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# آدرس(های) دامنه‌ای که اجازه دارن به این API درخواست بزنن (با کاما جدا کن اگه چندتاست)
CORS_ORIGIN=http://localhost:5173

# اطلاعات ورود ادمین
ADMIN_USERNAME=admin
# هش bcrypt پسورد ادمین — با server/scripts/hashPassword.js بساز، هیچ‌وقت پسورد خام اینجا نذار
ADMIN_PASSWORD_HASH=
